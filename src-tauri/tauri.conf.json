{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftMask",
  "version": "1.3.0",
  "identifier": "com.camilo.swiftmask",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SwiftMask",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/bin/libonnxruntime_providers_shared.so": "target/release/libonnxruntime_providers_shared.so",
          "/usr/bin/libonnxruntime_providers_cuda.so": "target/release/libonnxruntime_providers_cuda.so"
        }
      },
      "deb": {
        "files": {
          "/usr/bin/libonnxruntime_providers_shared.so": "target/release/libonnxruntime_providers_shared.so",
          "/usr/bin/libonnxruntime_providers_cuda.so": "target/release/libonnxruntime_providers_cuda.so"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/libonnxruntime_providers_shared.so": "target/release/libonnxruntime_providers_shared.so",
          "/usr/bin/libonnxruntime_providers_cuda.so": "target/release/libonnxruntime_providers_cuda.so"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNTQwRDA5QkYxQjRDRTQKUldUa1RCdS9DUTFVdng0aVcwUHZ5emNEN1pQNHRtOHJqcDN0amVVbGZWVkNwNWJYZTVyVzdLUlUK",
      "endpoints": [
        "https://github.com/camilopaezz/SwiftMask/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
