{
  "name": "swiftmask",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri",
    "tauri:build:cachy": "WEBKIT_DISABLE_COMPOSITING_MODE=1 NO_STRIP=true tauri build",
    "gen:models": "cargo run --manifest-path src-tauri/Cargo.toml --example gen_model_registry",
    "gen:models:check": "cargo run --manifest-path src-tauri/Cargo.toml --example gen_model_registry -- --check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "i18next": "^27.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
